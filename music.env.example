# Music Stream configuration. Copy to music.env (the installers do this for you and fill in real values).
# music.env holds your secret key: never commit it, never share it.
MUSIC_PORT=8125
# 127.0.0.1 = this computer only. 0.0.0.0 = also other devices on your Wi-Fi.
MUSIC_BIND=127.0.0.1
# Secret access key. The installer generates a random one; the server also creates one on first start if missing.
MUSIC_KEY=change-me-to-a-long-random-string
# Python that has yt-dlp installed (the installer points this at its own venv).
YTDLP_PY=python
# ffmpeg executable (mp3 downloads and the fallback stream need it).
FFMPEG=ffmpeg
# JavaScript runtime yt-dlp uses for YouTube: node, deno, node:C:\path\node.exe, or none.
YTDLP_JS_RUNTIME=node
# 0 = only update yt-dlp when you ask (scripts/update-ytdlp.*). 1 = auto-update on start.
YTDLP_AUTO_UPDATE=0
# Disk cache limit in GB.
CACHE_MAX_GB=5
# head-20261113: first ~10-15 s of audio on disk (LRU). Instant first-tap for hot songs.
HEAD_CACHE_MB=300
HEAD_CACHE_KB=384
# 1 = devices on your home LAN may skip the key (only matters with MUSIC_BIND=0.0.0.0).
MUSIC_TRUST_LAN=0
# Leave 0. 1 disables the key check entirely.
MUSIC_OPEN=0
# Optional: Cloudflare Access (team name + AUD tag) and extra allowed origins for a public hostname.
# MUSIC_CF_TEAM=
# MUSIC_CF_AUD=
# MUSIC_ORIGINS=music.example.com
# Optional Telegram bot (keep the token secret):
# MUSIC_BOT_TOKEN=
# MUSIC_ALLOWED_CHATS=

# How many server processes to run. auto = up to 3 (one per core Android lets Termux use).
# 1 = single process (old behaviour). The public port stays the same; extra workers bind locally only.
# MUSIC_WORKERS=auto
