#!/bin/sh /etc/rc.common
# OpenWrt procd template (ms-v75). install.sh --autostart fills @DIR@/@PY@; or copy by hand to /etc/init.d/music-stream.
# Router note: run the SERVER here only; leave ffmpeg out (no FFMPEG in music.env, not installed) and let phones/PCs do the decoding.
START=99
USE_PROCD=1
start_service() {
  procd_open_instance
  procd_set_param command "@PY@" "@DIR@/music_server.py"
  procd_set_param env HOME=/root   # server resolves its folder from __file__, so cwd does not matter
  procd_set_param respawn 3600 10 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
